          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n    avg(dateDiff('second', min_ts, max_ts)) AS tiempo_promedio_segundos\nFROM (\n    SELECT\n        person_id,\n        min(timestamp) AS min_ts,\n        max(timestamp) AS max_ts\n    FROM sauron.telemetry_events\n    GROUP BY person_id\n    HAVING count() >= 2 AND min_ts != max_ts\n)",
          "refId": "A"
        }
      ],
      "title": "Promedio de Permanencia",
      "type": "stat"
