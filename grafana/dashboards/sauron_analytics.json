          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n    person_id,\n    minIf(timestamp, zone = 'zona_extremo_a') AS fecha_entrada,\n    maxIf(timestamp, zone = 'zona_extremo_b') AS fecha_salida,\n    dateDiff('second', minIf(timestamp, zone = 'zona_extremo_a'), maxIf(timestamp, zone = 'zona_extremo_b')) AS permanencia_segundos,\n    argMinIf(snapshot_url, timestamp, zone = 'zona_extremo_a') AS foto_entrada,\n    argMaxIf(snapshot_url, timestamp, zone = 'zona_extremo_b') AS foto_salida\nFROM sauron.telemetry_events\nGROUP BY person_id\nORDER BY fecha_entrada DESC",
          "refId": "A"
        }
      ],
      "title": "Registro de Entradas, Salidas y Capturas por Persona",
      "type": "table"
    },
